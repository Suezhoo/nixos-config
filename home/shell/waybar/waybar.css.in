/*
 * Template source. waybar-theme renders the @@...@@ tokens to literal colors
 * before Waybar loads this stylesheet.
 */

/* Shared theme ----------------------------------------------------------- */

* {
  font-family:
    "Ubuntu", "MonaspiceNe Nerd Font", "JetBrainsMono Nerd Font",
    "Noto Sans CJK JP", "Noto Sans CJK KR", "Noto Sans CJK SC", monospace;
}

window#waybar {
  background-color: transparent;
  background-image: none;
  color: @@FOREGROUND@@;
  border: none;
  box-shadow: none;
}

window#waybar > box {
  background-color: @@BACKGROUND@@;
}

#custom-host,
#custom-os {
  color: @@ACCENT@@;
}

#custom-power {
  color: @@ACCENT@@;
}

#workspaces button {
  color: @@FOREGROUND@@;
  background: transparent;
  border: none;
  box-shadow: none;
  text-shadow: none;
}

#workspaces button.active,
#workspaces button.focused {
  color: @@FOREGROUND@@;
  background: @@ACTIVE@@;
}

#workspaces button:hover {
  color: @@ACCENT@@;
  background: alpha(@@ACCENT@@, 0.18);
  box-shadow: none;
}

/* Side profile: DP-2 and DP-4, 36px bar ------------------------------- */

window#waybar.side * {
  font-size: 12px;
}

window#waybar.side > box {
  border-radius: 10px;
  padding: 5px 8px;
}

window#waybar.side #custom-os {
  font-size: 24px;
  padding: 0 6px;
  margin-right: 12px;
}

window#waybar.side #custom-host {
  padding: 0 10px;
}

window#waybar.side #workspaces {
  border-radius: 5px;
  padding: 2px 6px;
}

window#waybar.side #workspaces button {
  min-width: 18px;
  padding: 0 3px;
  margin: 0 3px;
  border-radius: 5px;
}

window#waybar.side #custom-gpu,
window#waybar.side #pulseaudio,
window#waybar.side #clock,
window#waybar.side #network,
window#waybar.side #tray,
window#waybar.side #custom-power {
  padding: 0 8px;
}

/* Main profile: DP-3, 48px bar ----------------------------------------- */

window#waybar.main * {
  font-size: 14px;
}

window#waybar.main > box {
  border-radius: 13px;
  padding: 7px 10px;
}

window#waybar.main #custom-os {
  font-size: 32px;
  padding: 0 8px;
  margin-right: 16px;
}

window#waybar.main #custom-host {
  padding: 0 13px;
}

window#waybar.main #workspaces {
  border-radius: 7px;
  padding: 3px 8px;
  margin: 0 8px;
}

window#waybar.main #workspaces button {
  min-width: 24px;
  padding: 0 4px;
  margin: 0 4px;
  border-radius: 7px;
}

window#waybar.main #custom-gpu,
window#waybar.main #pulseaudio,
window#waybar.main #clock,
window#waybar.main #network,
window#waybar.main #tray,
window#waybar.main #custom-power {
  padding: 0 11px;
}
